web/node_modules/

# Embedded SPA build artifacts (gitignored, regenerated by Stage 1 and COPY'd
# into this path in Stage 2). Excluding the locally-accumulated copies prevents
# stale hashed files from leaking into the image if the local tree is dirty.
# Git-tracked source files (favicon.svg, icons.svg, manifest.json, sw.js) are
# intentionally NOT excluded.
internal/ui/static/assets/
internal/ui/static/ort/
internal/ui/static/ort.min.js
internal/ui/static/index.html

