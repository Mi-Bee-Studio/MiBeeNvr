#!/bin/bash
#
# Called BEFORE the application files are applied (and BEFORE fnOS runs
# `docker compose up`, which would otherwise try to pull the image). This is
# our one chance to seed the image into the local Docker daemon so the
# subsequent compose-up uses the bundled image instead of hitting the network.
#
# The .fpk bundles both arches as separate tarballs (mibee-nvr-<arch>.tar under
# the app images dir); we load ONLY the one matching this host's CPU
# (TRIM_SYS_ARCH). Each tarball was saved with the unified tag mibee-nvr:<version>
# (the one the compose references), so after load the compose finds it locally
# and never reaches the registry — critical for slow/offline fnOS installs.
#
# Runs as root (config/privilege run-as: root) because `docker load` needs the
# Docker socket.
set -euo pipefail

IMAGES_DIR="${TRIM_APPDEST}/images"
APP_VERSION="${TRIM_APPVER:-0.10.1}"

# Map fnOS arch names to the bundled tar suffixes.
case "${TRIM_SYS_ARCH:-}" in
  x86_64|amd64|x64)     ARCH="amd64" ;;
  aarch64|arm64|armv8*) ARCH="arm64" ;;
  *)
    echo "WARN: unsupported arch '${TRIM_SYS_ARCH:-<unset>}'; the app will fall back to pulling from the registry." > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 0
    ;;
esac

TAR="${IMAGES_DIR}/mibee-nvr-${ARCH}.tar"
if [ ! -f "$TAR" ]; then
  echo "WARN: bundled image '${TAR}' not found; the app will pull from the registry." > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  exit 0
fi

echo "Loading bundled image ${TAR}..."
# The tarball was saved with the tag the compose references (mibee-nvr:<version>),
# so no re-tag is needed — `docker compose up` finds it locally and skips the pull.
docker load -i "$TAR"
echo "Image loaded."
exit 0
