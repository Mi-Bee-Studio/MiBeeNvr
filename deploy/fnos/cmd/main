#!/bin/bash
#
# Native-app lifecycle controller for MiBee NVR on fnOS.
#
# This app manages its own Docker container (we do NOT use fnOS's
# docker-project resource, because that makes fnOS run `docker compose up`
# during install — before any lifecycle hook can `docker load` the bundled
# offline image, so the pull fails). Instead, cmd/main owns the full container
# lifecycle: start loads the bundled image + runs the container; stop/status
# manage it. This runs in the START phase, after files are extracted, so the
# image tar is on disk and the load succeeds.
#
# Runs as root (config/privilege run-as: root) — needs the Docker socket.
#
# Exit codes (fnOS): 0 = ok / running, 1 = error, 3 = not running (status).
set +e

CONTAINER="mibee-nvr"
APP_VERSION="${TRIM_APPVER:-0.11.0}"
IMAGE="mibee-nvr:${APP_VERSION}"
LOG="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log}"
PORT="${wizard_port:-${TRIM_SERVICE_PORT:-9090}}"
DATA_DIR="${TRIM_PKGVAR:-/var/lib/mibee-nvr}/data"
# frame-ancestors: allow the fnOS desktop to embed the UI. The desktop is
# cross-origin (served from a different port than the NVR's :9090), so 'self'
# alone is not enough. Use scheme-sources 'http:'/'https:' (NOT 'http://*',
# which only matches the default port 80 and is rejected for the desktop's
# non-default origin like http://host:5666).
FRAME_ANCESTORS="${NVR_FRAME_ANCESTORS:-'self' http: https:}"

log() { echo "[mibee-nvr main] $*" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1; }

# Load the bundled image for this host's arch if the image isn't present yet.
# OFFLINE package: a bundled tar exists under ${TRIM_APPDEST}/images/ → docker load.
# ONLINE package: no bundled tar → probe ghcr.io vs the Alibaba Cloud ACR mirror
# and pull the multi-arch image from whichever registry answers faster (ACR wins
# ties — mainland-China NASes are the reason the online package exists). The
# pulled image is re-tagged to the local name the container run expects.
GHCR_PREFIX="ghcr.io/mi-bee-studio/mibeenvr"
ACR_PREFIX="registry.cn-hangzhou.aliyuncs.com/mickeybeehome/mibee-nvr"

probe_registry() {  # probe_registry <url> → prints latency ms or "fail"
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    local t
    t=$(curl -s -o /dev/null -w '%{time_total}' \
          --connect-timeout 3 --max-time 6 "$url" 2>/dev/null) || { echo fail; return; }
    # seconds → milliseconds (keep one decimal for tie-breaking)
    awk -v t="$t" 'BEGIN{printf "%.1f", t*1000}'
  else
    # No curl on the NAS: fall back to a bare TCP connect timing via /dev/tcp.
    local host port
    host=$(echo "$url" | sed -E 's#https?://([^/]+)/.*#\1#')
    port=$(echo "$url" | grep -q '^https' && echo 443 || echo 80)
    local start end
    start=$(date +%s%3N)
    if ! timeout 6 bash -c "exec 3<>/dev/tcp/${host}/${port}" 2>/dev/null; then
      echo fail; return
    fi
    end=$(date +%s%3N)
    echo $((end - start))
  fi
}

choose_registry() {
  local tmp; tmp="$(mktemp -d)"
  ( probe_registry "https://ghcr.io/v2/"                           > "$tmp/ghcr" ) &
  ( probe_registry "https://registry.cn-hangzhou.aliyuncs.com/v2/" > "$tmp/acr"  ) &
  wait
  local g a; g="$(cat "$tmp/ghcr" 2>/dev/null)"; a="$(cat "$tmp/acr" 2>/dev/null)"
  rm -rf "$tmp"
  if [ "$g" = "fail" ] && [ "$a" = "fail" ]; then
    log "both registries unreachable"
    return 1
  fi
  if [ "$g" = "fail" ]; then echo "$ACR_PREFIX";  log "ghcr unreachable → ACR";  return 0; fi
  if [ "$a" = "fail" ]; then echo "$GHCR_PREFIX"; log "ACR unreachable → ghcr"; return 0; fi
  # both reachable → lower latency wins; ACR wins ties (CN-friendly default)
  if awk -v a="$a" -v g="$g" 'BEGIN{exit !(a < g)}'; then
    echo "$ACR_PREFIX"; log "ACR faster (${a}ms < ${g}ms)"
  else
    echo "$GHCR_PREFIX"; log "ghcr faster (${g}ms ≤ ${a}ms)"
  fi
}

ensure_image() {
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi
  local arch=""
  case "${TRIM_SYS_ARCH:-}" in
    # fnOS reports "x86" for x86_64 hosts (it ships no 32-bit x86 build, so
    # "x86" is unambiguously the 64-bit flavor and maps to our amd64 image).
    x86_64|amd64|x64|x86)      arch="amd64" ;;
    # fnOS may report bare "arm" (32-bit userspace on some ARM boards); the
    # bundled arm64 image runs fine under a 64-bit kernel. Map all ARM variants
    # to the arm64 tarball.
    aarch64|arm64|armv8*|arm)  arch="arm64" ;;
    *) arch="" ;;
  esac
  local tar="${TRIM_APPDEST}/images/mibee-nvr-${arch}.tar"
  if [ -z "$arch" ]; then
    log "cannot map arch='${TRIM_SYS_ARCH:-<unset>}'"
    echo "[mibee-nvr] Unsupported arch '${TRIM_SYS_ARCH}'. See ${TRIM_PKGVAR}/mibee-nvr-main.log." > "$LOG"
    return 1
  fi
  if [ ! -f "$tar" ]; then
    # ONLINE package: no bundled tar — pull from the best registry instead.
    local reg
    reg="$(choose_registry)" || {
      echo "[mibee-nvr] Both ghcr.io and the ACR mirror are unreachable. Check the network and retry start." > "$LOG"
      return 1
    }
    local remote="${reg}:${APP_VERSION}"
    log "online mode: pulling ${remote}"
    # ACR manual pushes sometimes carry a 'v' prefix (v0.11.0) while CI mirrors
    # use the bare version (0.11.0). Try bare first, fall back to v-prefixed.
    if ! docker pull "$remote" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1; then
      if [ "$reg" = "$ACR_PREFIX" ]; then
        log "bare tag ${APP_VERSION} missing on ACR, retrying v${APP_VERSION}"
        remote="${ACR_PREFIX}:v${APP_VERSION}"
        docker pull "$remote" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1 || return 1
      else
        return 1
      fi
    fi
    docker tag "$remote" "$IMAGE" || return 1
    return 0
  fi
  log "loading $tar"
  docker load -i "$tar" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1
  log "docker load exit=$?"
  docker image inspect "$IMAGE" >/dev/null 2>&1 || { log "image still missing after load"; return 1; }
  return 0
}

is_running() {
  docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true
}

# Unified-gateway integration (#394): fnOS forwards authenticated desktop
# requests to a Unix socket inside the app's install dir. We mount TRIM_APPDEST
# into the container and tell the NVR (via env) to listen on the socket and to
# serve under the /app/mibee-nvr prefix. Desktop users then get SSO (the
# gateway injects verified X-Trim-* identity headers); direct :9090 access
# still requires the normal NVR login. GW_ARGS stays empty when TRIM_APPDEST is
# absent (e.g. bare docker runs) so the container works without fnOS too.
# NB: no socket cleanup here — fnOS re-invokes this script for *every* status
# poll, and a top-level `rm -f app.sock` deletes the LIVE socket ~20s after
# start. Stale-socket cleanup belongs in the start branch (pre-run) and stop
# branch only.
GATEWAY_PREFIX="/app/mibee-nvr"
GW_ARGS=()
if [ -n "${TRIM_APPDEST:-}" ] && [ -d "${TRIM_APPDEST}" ]; then
  mkdir -p "${TRIM_APPDEST}"
  GW_ARGS=(-v "${TRIM_APPDEST}:/fnos-gateway"
           -e "NVR_UNIX_SOCKET=/fnos-gateway/app.sock"
           -e "NVR_BASE_PATH=${GATEWAY_PREFIX}")
  log "unified gateway enabled: socket=${TRIM_APPDEST}/app.sock prefix=${GATEWAY_PREFIX}"
else
  log "TRIM_APPDEST not set — unified gateway disabled (direct port only)"
fi

# User-authorized extra storage (#395): fnOS delivers the directories the user
# granted to this app in App-Center settings via TRIM_DATA_ACCESSIBLE_PATHS
# (colon-separated). Each is mounted into the container under /media/<name> and
# the container paths are handed to the NVR via NVR_STORAGE_CANDIDATES — the
# settings UI then offers them as recording-root choices. Nothing granted → no
# mounts, no candidates (the app data dir stays the only storage).
STORAGE_ARGS=()
STORAGE_CANDIDATES=""
if [ -n "${TRIM_DATA_ACCESSIBLE_PATHS:-}" ]; then
  OLDIFS="$IFS"; IFS=":"
  for host_dir in $TRIM_DATA_ACCESSIBLE_PATHS; do
    [ -d "$host_dir" ] || continue
    # Sanitize the mount name (docker bind targets reject some chars; the
    # trailing underscore scrub drops the newline tr synthesizes from $(echo)).
    name=$(basename "$host_dir" | tr -c 'A-Za-z0-9_.-' '_' | sed 's/_\+$//')
    [ -n "$name" ] || name="storage"
    STORAGE_ARGS+=(-v "${host_dir}:/media/${name}:rw")
    if [ -n "$STORAGE_CANDIDATES" ]; then
      STORAGE_CANDIDATES="${STORAGE_CANDIDATES}:/media/${name}"
    else
      STORAGE_CANDIDATES="/media/${name}"
    fi
    log "extra storage mounted: ${host_dir} -> /media/${name}"
  done
  IFS="$OLDIFS"
  [ -n "$STORAGE_CANDIDATES" ] && STORAGE_ARGS+=(-e "NVR_STORAGE_CANDIDATES=${STORAGE_CANDIDATES}")
fi

case "$1" in
  start)
    log "=== start === arch=${TRIM_SYS_ARCH:-<unset>} port=$PORT"
    if is_running; then log "already running"; exit 0; fi
    ensure_image || exit 1
    mkdir -p "$DATA_DIR"
    # Remove a stale socket left by an unclean shutdown before the new
    # container binds it (net.Listen on a stale file fails with EADDRINUSE).
    [ -n "${TRIM_APPDEST:-}" ] && rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null || true
    log "docker run $IMAGE (host net, port $PORT, data $DATA_DIR)"
    docker run -d \
      --name "$CONTAINER" \
      --restart unless-stopped \
      --network host \
      -e NVR_DATA_DIR=/data \
      -e "NVR_LISTEN_PORT=$PORT" \
      -e "NVR_FRAME_ANCESTORS=$FRAME_ANCESTORS" \
      -v "${DATA_DIR}:/data" \
      "${GW_ARGS[@]}" \
      "${STORAGE_ARGS[@]}" \
      "$IMAGE" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1
    rc=$?
    log "docker run exit=$rc"
    # Give it a moment, then verify it's up.
    sleep 2
    if is_running; then log "started ok"; exit 0; fi
    echo "[mibee-nvr] container failed to start. See ${TRIM_PKGVAR}/mibee-nvr-main.log." > "$LOG"
    exit 1
    ;;

  stop)
    log "=== stop ==="
    docker stop "$CONTAINER" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1
    docker rm "$CONTAINER" >> "${TRIM_PKGVAR:-/tmp}/mibee-nvr-main.log" 2>&1
    # Remove the gateway socket too — a stale file makes fnOS report the app
    # entry as broken until the next start recreates it.
    [ -n "${TRIM_APPDEST:-}" ] && rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null || true
    log "stopped"
    exit 0
    ;;

  status)
    if is_running; then exit 0; fi
    exit 3
    ;;

  *)
    echo "Unknown command: $1" > "$LOG"
    exit 1
    ;;
esac
