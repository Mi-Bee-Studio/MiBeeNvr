[Unit]
Description=MiBee NVR - Network Video Recorder
After=network.target
Requires=network.target
# Crash-loop fuse: a fatal config error (e.g. a hand-edited YAML) must not
# hammer the box forever — 5 restarts within 2 minutes stop the unit until an
# operator intervenes (`journalctl -u mibee-nvr` shows the validation error).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nvr
Group=nvr
ExecStart=/usr/local/bin/mibee-nvr -config /var/lib/mibee-nvr/mibee-nvr.yaml
Restart=on-failure
RestartSec=5s
WorkingDirectory=/var/lib/mibee-nvr
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mibee-nvr

# Memory discipline (#756) — 512MiB design baseline (RPi-3B class):
# MemoryHigh is a SOFT limit (kernel reclaims instead of OOM-killing),
# MemoryMax the hard backstop. Adjust per board:
#   1GB RAM board:  High=450M  Max=550M  (shipped values)
#   4GB RAM board:  High=1500M Max=2G
# The Go-side GOMEMLIMIT (set automatically at startup) keeps the heap well
# below these — the unit limits are the outer safety net, not the primary
# mechanism. See docs: Performance Tuning > Memory Tiering.
MemoryHigh=450M
MemoryMax=550M

[Install]
WantedBy=multi-user.target