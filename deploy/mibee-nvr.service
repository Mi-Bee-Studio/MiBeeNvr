[Unit]
Description=MiBee NVR - Network Video Recorder
After=network.target
Requires=network.target
# Crash-loop fuse: a fatal config error (e.g. a hand-edited YAML) must not
# hammer the box forever — 5 restarts within 2 minutes stop the unit until an
# operator intervenes (`journalctl -u mibee-nvr` shows the validation error).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nvr
Group=nvr
ExecStart=/usr/local/bin/mibee-nvr -config /var/lib/mibee-nvr/mibee-nvr.yaml
Restart=on-failure
RestartSec=5s
WorkingDirectory=/var/lib/mibee-nvr
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mibee-nvr

# Memory discipline (#756) — OPTIONAL outer safety net, left DISABLED by
# default: these values are sized for the 512MiB design baseline (RPi-3B
# class); enabling them verbatim on a bigger board (e.g. 4GB M5 with ~1.6GB
# heap peaks) OOM-kills the service. The in-process GOMEMLIMIT (set
# automatically at startup, see memory.* config) is the primary mechanism.
# To enable per board, uncomment and size accordingly:
#   1GB RAM board:  MemoryHigh=450M  MemoryMax=550M
#   4GB RAM board:  MemoryHigh=1500M MemoryMax=2G
# See docs: Performance Tuning > Memory Tiering.
#MemoryHigh=450M
#MemoryMax=550M

[Install]
WantedBy=multi-user.target
